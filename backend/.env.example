# Salin ke backend/.env lalu isi nilainya. Berkas .env tidak ikut di-commit.
# Nilai kosong = fitur opsional itu mati, pengenalan tetap berjalan.

# Audio pengucapan Sunda (APIPedia). Tanpa key, audio_url = null.
APIPEDIA_API_KEY=
APIPEDIA_VOICE=su-ID-TutiNeural

# Arti kata lewat Google Apps Script: POST {"text": "..."} -> {"translation": "..."}
GOOGLE_TRANSLATE_SCRIPT_URL=
# Fallback Google Cloud Translation Basic v2 jika Apps Script tidak tersedia.
GOOGLE_TRANSLATE_API_KEY=

# Opsional (lihat backend/README.md dan docs/deploy.md).
# AKSARA_CORS_ORIGIN=http://localhost:5173
# AKSARA_AUDIO_DIR=backend/audio
# AKSARA_MAX_UPLOAD_BYTES=8388608
# AKSARA_MODEL=vision/models/aksara_crnn.keras
